<figure class="min-w-0 overflow-hidden rounded-lg border border-base-300">
  <% if web_url?(source) %>
    <img src="<%= h source %>" alt="<%= h label %>" loading="lazy" referrerpolicy="no-referrer" data-remote-image class="aspect-[4/3] w-full bg-base-200 object-contain">
    <p data-image-fallback hidden class="bg-base-200 p-5 text-lg text-muted">This image could not be loaded.</p>
  <% else %>
    <p class="flex aspect-[4/3] items-center justify-center bg-base-200 p-5 text-center text-lg text-muted"><%= source.to_s.empty? ? 'No image available' : 'Preview unavailable for this URL type' %></p>
  <% end %>
  <figcaption class="p-3">
    <p class="text-lg font-medium"><%= h label %></p>
    <% if dimensions %><p class="mt-1 font-mono text-base text-muted"><%= h dimensions %></p><% end %>
    <% unless source.to_s.empty? %><p class="mt-2 max-h-20 overflow-y-auto text-base leading-relaxed text-muted [overflow-wrap:anywhere]"><%= external_link(source) %></p><% end %>
  </figcaption>
</figure>
