<form method="get" action="/scrape" data-scrape-form class="rounded-2xl border border-base-300 bg-base-100 p-5 shadow-sm sm:p-6">
  <label for="url" class="mb-3 block text-lg font-semibold">Page URL</label>
  <div class="flex flex-col gap-3 sm:flex-row">
    <input id="url" type="url" name="url" required placeholder="https://example.com" value="<%= h @submitted_url %>" aria-describedby="url-help" class="input h-14 w-full min-w-0 flex-1 rounded-lg border-base-content/60 bg-base-100 px-4 text-lg placeholder:text-muted">
    <button type="submit" class="btn btn-primary h-14 rounded-lg px-6 text-lg font-semibold" data-submit>Inspect page <span aria-hidden="true">→</span></button>
  </div>
  <div class="mt-4 flex flex-wrap items-center justify-between gap-3 text-lg text-muted">
    <p id="url-help">Enter a public HTML page to explore its data.</p>
    <label class="flex cursor-pointer flex-wrap items-center gap-2"><input type="checkbox" name="image_details" value="1" <%= 'checked' if params[:image_details] == '1' %> class="size-5 accent-primary"> Fetch image details <span class="text-base">(up to 6 images)</span></label>
  </div>
  <div class="mt-6 border-t border-base-300 pt-5">
    <label for="user-agent" class="mb-3 block text-lg font-semibold">User Agent</label>
    <input id="user-agent" type="text" name="user_agent" value="<%= h user_agent %>" spellcheck="false" autocapitalize="off" autocomplete="off" aria-describedby="user-agent-help" class="input h-14 w-full min-w-0 rounded-lg border-base-content/60 bg-base-100 px-4 text-lg">
    <p id="user-agent-help" class="mt-3 text-lg text-muted">Defaults to your browser’s User Agent. Edit it to simulate another browser or bot, or leave blank to use yours.</p>
  </div>
  <p role="status" data-form-status class="mt-3 text-lg text-muted" hidden></p>
</form>
